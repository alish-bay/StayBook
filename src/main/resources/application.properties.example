spring.application.name=StayBook
server.port=8080

# ===================================================================
# 1. User Database Configuration (Example template without secrets)
# ===================================================================
spring.datasource.user.url=jdbc:postgresql://<DB_HOST>:<DB_PORT>/staybook_user_db
spring.datasource.user.username=<YOUR_USER_DB_USERNAME>
spring.datasource.user.password=<YOUR_USER_DB_PASSWORD>
spring.datasource.user.driver-class-name=org.postgresql.Driver

# ===================================================================
# 2. Room Database Configuration
# ===================================================================
spring.datasource.room.url=jdbc:postgresql://<DB_HOST>:<DB_PORT>/staybook_room_db
spring.datasource.room.username=<YOUR_ROOM_DB_USERNAME>
spring.datasource.room.password=<YOUR_ROOM_DB_PASSWORD>
spring.datasource.room.driver-class-name=org.postgresql.Driver

# ===================================================================
# 3. Booking Database Configuration
# ===================================================================
spring.datasource.booking.url=jdbc:postgresql://<DB_HOST>:<DB_PORT>/staybook_booking_db
spring.datasource.booking.username=<YOUR_BOOKING_DB_USERNAME>
spring.datasource.booking.password=<YOUR_BOOKING_DB_PASSWORD>
spring.datasource.booking.driver-class-name=org.postgresql.Driver

# ===================================================================
# Common JPA / Hibernate Configuration
# ===================================================================
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# ===================================================================
# Liquibase Multi-Database Migration Configuration
# ===================================================================
spring.liquibase.enabled=false
staybook.liquibase.enabled=true
